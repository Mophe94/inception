# Copy this file to srcs/.env and replace every <placeholder>:
#   cp srcs/.env.example srcs/.env

# Domain (must point to the VM — `make` adds it to /etc/hosts)
DOMAIN_NAME=<login>.42.fr

# MariaDB
SQL_DATABASE=wordpress
SQL_USER=<db_user>
SQL_PASSWORD=<db_password>
SQL_ROOT_PASSWORD=<db_root_password>

# WordPress administrator (the username must not contain "admin")
WP_ADMIN_USER=<admin_user>
WP_ADMIN_PASSWORD=<admin_password>
WP_ADMIN_EMAIL=admin@example.com

# WordPress secondary user (role: author) — email must differ from the admin's
WP_USER=<user>
WP_USER_PASSWORD=<user_password>
WP_USER_EMAIL=user@example.com

# WordPress version downloaded by WP-CLI on first start (must support PHP 8.2)
WP_VERSION=6.4

# Host directories backing the two named volumes
# (`make` rewrites /home/<login>/ to the current user automatically)
SQL_DATA_PATH=/home/<login>/data/mariadb
WP_DATA_PATH=/home/<login>/data/wordpress