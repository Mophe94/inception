[mysqld]               # Section principale pour le serveur MariaDB, contient toutes les directives pour le serveur SQL

# ----------------------------
# Sécurité
# ----------------------------
user = mysql            # Exécuter MariaDB avec l'utilisateur 'mysql' pour limiter les droits système

# ----------------------------
# Réseau et connexions
# ----------------------------
# port = 3306           # Port par défaut pour les connexions MySQL (décommenter si besoin de changer)
bind-address = 0.0.0.0  # Autoriser les connexions depuis toutes les interfaces réseau
                        # Important pour que d'autres conteneurs Docker (WordPress, etc.) puissent se connecter

# ----------------------------
# Fichiers et répertoires
# ----------------------------
pid-file = /run/mysqld/mysqld.pid   # Fichier PID, utile pour le suivi des processus (facultatif)
basedir = /usr                      # Répertoire d'installation de MariaDB
datadir = /var/lib/mysql            # Répertoire où sont stockées les bases de données
tmpdir = /tmp                       # Répertoire pour les fichiers temporaires
lc-messages-dir = /usr/share/mysql  # Répertoire contenant les fichiers de traduction des messages

# ----------------------------
# Langue et encodage
# ----------------------------
lc-messages = en_US                 # Langue utilisée pour les messages du serveur
character-set-server = utf8mb4      # Encodage par défaut des bases de données (supporte les emojis)
collation-server = utf8mb4_general_ci  # Collation par défaut pour l'encodage

# ----------------------------
# Performance et fonctionnement
# ----------------------------
skip-external-locking                 # Désactive le verrouillage externe, améliore les performances en conteneur
expire_logs_days = 10                 # Supprime automatiquement les anciens logs après 10 jours

